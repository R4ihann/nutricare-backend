// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DONE
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Province {
  id     Int    @id @default(autoincrement())
  name   String @unique
  cities City[]
}

model City {
  id         Int      @id @default(autoincrement())
  name       String
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id])
  users      User[]
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(USER)
  cityId        Int?
  city          City?          @relation(fields: [cityId], references: [id])
  fullAddress   String?
  addressDetail String?
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
  reviews       Review[]
}

model Category {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  description   String?
  cateringPlans CateringPlan[]
}

model CateringPlan {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  duration      Int
  imageUrl      String?
  isActive      Boolean        @default(true)
  categoryId    Int
  category      Category       @relation(fields: [categoryId], references: [id])
  meals         Meal[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())

  reviews Review[]
}

model Meal {
  id             Int          @id @default(autoincrement())
  name           String
  calories       Float
  protein        Float
  carbs          Float
  fat            Float
  ingredients    String
  imageUrl       String? // <-- ADD THIS LINE
  cateringPlanId Int
  cateringPlan   CateringPlan @relation(fields: [cateringPlanId], references: [id])
}

model Subscription {
  id             Int           @id @default(autoincrement())
  userId         Int
  cateringPlanId Int
  startDate      DateTime
  endDate        DateTime
  totalPrice     Float
  orderStatus    OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  cateringPlan   CateringPlan  @relation(fields: [cateringPlanId], references: [id])
}

model Review {
  id             Int          @id @default(autoincrement())
  userId         Int
  cateringPlanId Int
  rating         Int          @default(5)
  comment        String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  cateringPlan   CateringPlan @relation(fields: [cateringPlanId], references: [id])

  @@unique([userId, cateringPlanId]) // One review per user per plan
}
